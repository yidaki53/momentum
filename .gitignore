# Python
__pycache__/
*.py[cod]
*.egg-info/
build/

# Cython build artefacts.
#
# NOTE: gitignore has no inline-comment syntax -- a "#" on the same line is part
# of the pattern, so the previous "*.so  # Cython-compiled shared objects" style
# rules matched nothing and build output showed up as untracked noise. The
# generated .c files stay committed on purpose (CI compiles the committed copy
# when a checkout's .pyx/.c timestamps are equal), so these rules only stop *new*
# build output from being added by accident.
*.c
*.so
*.pyd

# PyInstaller artifacts (but allow dist/momentum via LFS)
dist/*
!dist/momentum

# Virtual environment
.venv

# Poetry
poetry.lock

# Testing / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Buildozer
mobile/.buildozer/
mobile/bin/

# Local Android signing artifacts
mobile/.ci/*.keystore
mobile/.ci/*.jks
mobile/.ci/*.p12

# SQLite database (user data, not committed)
*.db

# IDE
.vscode/
.idea/

# AI context
WARP.md
AGENTS.md
CLAUDE.md
